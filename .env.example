# Copy this file to .env.local and fill in real values before deploying.

# --- Practice identity (used as fallback if not hardcoded in lib/config.ts) ---
NEXT_PUBLIC_PRACTICE_NAME="Bright Smile Dental"
NEXT_PUBLIC_PRACTICE_PHONE="(512) 555-0142"
NEXT_PUBLIC_PRACTICE_PHONE_RAW="+15125550142"
NEXT_PUBLIC_PRACTICE_EMAIL="hello@brightsmiledental.example"
NEXT_PUBLIC_PRACTICE_ADDRESS_STREET="4820 Bluebonnet Lane, Suite 200"
NEXT_PUBLIC_PRACTICE_ADDRESS_CITY="Austin"
NEXT_PUBLIC_PRACTICE_ADDRESS_STATE="TX"
NEXT_PUBLIC_PRACTICE_ADDRESS_ZIP="78745"

# --- Sanity.io (headless CMS) ---
# Create a project at https://www.sanity.io/manage and paste its project ID below.
# Leave blank during development — the site falls back to mock content in /lib/mock-content.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# Read token is only required for previewing drafts; leave blank for published-only reads.
SANITY_API_READ_TOKEN=""

# --- Booking lead destination ---
# Where new-patient booking form submissions are sent. Can be a plain email address
# (handled by a transactional email provider you wire up) or a webhook URL (e.g. Zapier,
# Make, a CRM inbox). The API route at /app/api/book-appointment reads this.
BOOKING_LEAD_DESTINATION="https://hooks.example.com/booking-leads"

# --- Analytics ---
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-JE196Y7DVJ"

# Call-tracking (e.g. CallRail). Leave blank to disable; see app/layout.tsx for the stub.
NEXT_PUBLIC_CALLRAIL_SWAP_ID=""

# --- Google Places / Reviews (used on /reviews to pull live ratings) ---
# Leave blank to fall back to the seeded mock reviews in /lib/mock-content.ts.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACES_ID=""
